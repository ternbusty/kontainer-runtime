# runc bats integration test pattern for kontainer-runtime
#
# Each line is either a test name to run, or prefixed with [skip] to skip.
# Blank lines and lines starting with # are ignored.
#
# Categories of skips (same as takoyaki):
#   criu         checkpoint/restore not implemented
#   systemd      systemd cgroup manager not supported
#   cgroups_v1   test only valid on cgroups v1
#   selinux      requires SELinux enabled
#   sshfs        requires sshfs fuse mount
#   arch         architecture-specific (i386/x86_64 personality)
#   runc-dmz     asserts runc-dmz debug output string

# --- spec ---
spec generation cwd
spec generation --bundle

# --- version / help ---
runc version
runc -h
runc command -h
runc foo -h

# --- debug / logging ---
global --debug
global --debug to --log
global --debug to --log --log-format 'json'
global --debug to --log --log-format 'text'
global --root

# --- create ---
runc create
runc create (no limits + no cgrouppath + no permission) succeeds
runc create --pid-file
runc create --pid-file with new CWD
runc create [terminal=false]
[skip]runc create (limits + cgrouppath + permission on the cgroup dir) succeeds # systemd
runc create (rootless + limits + no cgrouppath + no permission) fails with informative error
runc create (rootless + no limits + cgrouppath + no permission) fails with permission error
runc create [ --pidfd-socket ]
runc create [hook fails]
runc create [second createRuntime hook fails]
runc create [shared pidns + rootless]
runc create can chdir if runc has access
runc create sets up user before chdir to cwd if needed
runc create exec
runc create[detect fd leak as comprehensively as possible]

# --- start ---
runc start

