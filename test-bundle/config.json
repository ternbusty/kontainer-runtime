{
  "ociVersion": "1.0.0",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "process": {
    "args": [
      "/bin/busybox",
      "sleep",
      "30"
    ],
    "env": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "HOSTNAME=kontainer-test"
    ],
    "cwd": "/",
    "user": {
      "uid": 0,
      "gid": 0
    },
    "noNewPrivileges": true
  },
  "hostname": "kontainer-test",
  "linux": {
    "namespaces": [
      {
        "type": "pid"
      },
      {
        "type": "mount"
      },
      {
        "type": "network"
      },
      {
        "type": "uts"
      },
      {
        "type": "ipc"
      }
    ],
    "cgroupsPath": "kontainer-test",
    "resources": {
      "memory": {
        "limit": 536870912
      },
      "cpu": {
        "shares": 1024,
        "quota": 50000,
        "period": 100000
      }
    },
    "seccomp": {
      "defaultAction": "SCMP_ACT_ALLOW",
      "syscalls": [
        {
          "names": ["chmod", "fchmod", "fchmodat"],
          "action": "SCMP_ACT_ERRNO",
          "errnoRet": 1
        }
      ]
    }
  }
}
