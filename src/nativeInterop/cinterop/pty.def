headers = stdlib.h fcntl.h unistd.h sys/ioctl.h termios.h
headerFilter = stdlib.h fcntl.h unistd.h sys/ioctl.h termios.h
package = platform.pty
compilerOpts = -D_GNU_SOURCE -D_XOPEN_SOURCE=600
---

#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/ioctl.h>
#include <termios.h>

// posix_openpt is in <stdlib.h> with _XOPEN_SOURCE >= 600
static inline int pty_openpt(int flags) {
    return posix_openpt(flags);
}

static inline int pty_grantpt(int fd) {
    return grantpt(fd);
}

static inline int pty_unlockpt(int fd) {
    return unlockpt(fd);
}

// ptsname_r requires _GNU_SOURCE on glibc
static inline int pty_ptsname_r(int fd, char *buf, int buflen) {
    return ptsname_r(fd, buf, (size_t)buflen);
}

static inline unsigned long _TIOCSWINSZ() {
    return TIOCSWINSZ;
}

static inline unsigned long _TIOCSCTTY() {
    return TIOCSCTTY;
}

// Disable ONLCR (NL → CR-NL translation) on a terminal FD.
// This prevents PTY slaves from inserting \r before \n, which
// would break callers that capture output (like bats test framework).
// Must be called AFTER open() but BEFORE the slave is used.
static inline int pty_disable_onlcr(int fd) {
    struct termios t;
    if (tcgetattr(fd, &t) != 0) return -1;
    t.c_oflag &= ~ONLCR;
    return tcsetattr(fd, TCSANOW, &t);
}

// Set window size on a terminal FD.
// Wraps the ioctl(TIOCSWINSZ) call with a struct winsize so callers
// do not depend on platform-specific field names (ws_row vs __ws_row
// on aarch64).
static inline int pty_set_winsize(int fd, unsigned short rows,
                                  unsigned short cols) {
    struct winsize ws;
    ws.ws_row    = rows;
    ws.ws_col    = cols;
    ws.ws_xpixel = 0;
    ws.ws_ypixel = 0;
    return ioctl(fd, TIOCSWINSZ, &ws);
}
