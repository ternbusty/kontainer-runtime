headers = sched.h sys/syscall.h
headerFilter = sched.h sys/syscall.h
package = platform.linux
compilerOpts = -D_GNU_SOURCE
---

// Namespace flags for clone/unshare
static inline int _CLONE_NEWNS() {
    return CLONE_NEWNS;
}

static inline int _CLONE_NEWUTS() {
    return CLONE_NEWUTS;
}

static inline int _CLONE_NEWIPC() {
    return CLONE_NEWIPC;
}

static inline int _CLONE_NEWUSER() {
    return CLONE_NEWUSER;
}

static inline int _CLONE_NEWPID() {
    return CLONE_NEWPID;
}

static inline int _CLONE_NEWNET() {
    return CLONE_NEWNET;
}

// Other clone flags
static inline int _CLONE_PARENT() {
    return CLONE_PARENT;
}

// CLONE_NEWCGROUP may not be in older headers; #define it ourselves at value 0x02000000.
#ifndef CLONE_NEWCGROUP
#define CLONE_NEWCGROUP 0x02000000
#endif
static inline int _CLONE_NEWCGROUP() {
    return CLONE_NEWCGROUP;
}

// setns(2) wrapper. nstype acts as a guard against opening the wrong kind of fd
// (pass 0 to disable the check). Returns 0 on success or -1 with errno set.
static inline int setns_wrapper(int fd, int nstype) {
    return setns(fd, nstype);
}

// pidfd_open(2) — returns a file descriptor referring to a process.
// Available since Linux 5.3.
static inline long _NR_pidfd_open() {
#ifdef __NR_pidfd_open
    return __NR_pidfd_open;
#else
    return 434;
#endif
}

// ioprio_set(2) — set I/O scheduling class and priority.
static inline long _NR_ioprio_set() {
#ifdef __NR_ioprio_set
    return __NR_ioprio_set;
#else
    return 251;
#endif
}

// sched_setattr(2) — set scheduling policy and attributes.
static inline long _NR_sched_setattr() {
#ifdef __NR_sched_setattr
    return __NR_sched_setattr;
#else
    return 314;
#endif
}

// sched_setaffinity(2) — set CPU affinity mask.
static inline long _NR_sched_setaffinity() {
#ifdef __NR_sched_setaffinity
    return __NR_sched_setaffinity;
#else
    return 203;
#endif
}

// set_mempolicy(2) — set NUMA memory policy.
static inline long _NR_set_mempolicy() {
#ifdef __NR_set_mempolicy
    return __NR_set_mempolicy;
#else
    return 238;
#endif
}
